{
	"schemaVersion": 1,
	"id": "elytra_aeronautics",
	"version": "${version}",
	"name": "Elytra aeronautics",
	"description": "Fly faster with the elytra the higher you travel. 26.2 port of Soulphur's mod: altitude-based speed, firework boost, sneak to level out, and the extra cloud layers from the old cloud_layers.json. Chunk unloading is not ported.",
	"authors": ["Soulphur", "KIRILLAND78 (1.21.x port)"],
	"contact": {
		"homepage": "https://github.com/Soulphur0/ElytraAeronautics",
		"sources": "https://github.com/KIRILLAND78/ElytraAeronauticsPort"
	},
	"license": "CC-BY-NC-SA-4.0",
	"environment": "*",
	"entrypoints": {
		"main": ["com.github.Soulphur0.ElytraAeronautics"],
		"client": ["com.github.Soulphur0.ElytraAeronauticsClient"]
	},
	"mixins": [
		"elytraaeronautics.mixins.json",
		{ "config": "elytraaeronautics.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
